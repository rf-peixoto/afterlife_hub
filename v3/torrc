# AFTERLIFE hidden service configuration.
# No SOCKS proxy - this instance only serves as a hidden service relay.
SocksPort 0

# Hidden service: Tor listens on the .onion address and forwards
# connections to the AFTERLIFE server on loopback.
HiddenServiceDir /var/lib/tor/afterlife_hs
HiddenServicePort 2077 127.0.0.1:2077
HiddenServiceMaxStreams 20
HiddenServiceMaxStreamsCloseCircuit 1

# --- Onion-service denial-of-service defenses (network layer) ---
# The application server only ever sees 127.0.0.1, so it cannot rate-limit
# individual clients by address. Tor itself is the right place to absorb
# connection floods. Requires Tor 0.4.8+ (check with `tor --version`).
#
# HiddenServicePoWDefensesEnabled makes clients solve a memory-hard Equi-X
# puzzle *only while the service is under load*, and prioritizes clients who did
# more work. This complements the application-layer scrypt PoW: Tor throttles
# connection floods, the app throttles account abuse.
HiddenServicePoWDefensesEnabled 1
# Queue rate/burst for verified-effort connections once the defense engages.
HiddenServicePoWQueueRate 250
HiddenServicePoWQueueBurst 2500

# Introduction-point DoS defense: cap the rate of introduction requests so a
# flood cannot exhaust the service's introduction circuits.
HiddenServiceEnableIntroDoSDefense 1
HiddenServiceEnableIntroDoSRatePerSec 25
HiddenServiceEnableIntroDoSBurstPerSec 200

# Require v3 onion addresses (v2 is deprecated and insecure).
HiddenServiceVersion 3

# Log to stderr so Docker captures it.
Log notice stderr

# Tor data directory (distinct from hidden service directory).
DataDirectory /var/lib/tor/data
